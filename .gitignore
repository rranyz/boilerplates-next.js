# =============================================================================
# Root .gitignore — applies to the WHOLE repository, including every app in
# apps/* and every package in packages/*.
#
# Patterns without a leading "/" match at any depth, so do NOT add nested
# .gitignore files to individual apps. See "App-specific additions" at the
# bottom for how to extend this file safely.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/

# Yarn Berry (v2+): keep patches/plugins/releases/sdks/versions, ignore the rest
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions
.pnp.*

# NOTE: lockfiles (package-lock.json, pnpm-lock.yaml, yarn.lock) are
# intentionally NOT ignored and must be committed.

# -----------------------------------------------------------------------------
# Next.js
# -----------------------------------------------------------------------------
.next/
out/
# Regenerated by `next dev` / `next build`
next-env.d.ts
.vercel/

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
dist/
build/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Tool and framework caches
# -----------------------------------------------------------------------------
.turbo/
.cache/
.swc/
.parcel-cache/
.eslintcache
.stylelintcache

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
**/playwright/.cache/

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
tmp/
temp/
*.tmp
*.temp
*.pid
*.pid.lock
*.seed

# -----------------------------------------------------------------------------
# Environment files (secrets)
# Every .env / .env.* file is ignored; only safe templates are tracked.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Local certificates and private keys (e.g. `next dev --experimental-https`)
*.pem

# -----------------------------------------------------------------------------
# Editors and IDEs
# Shared VS Code workspace settings may be committed; everything else is local.
# -----------------------------------------------------------------------------
.idea/
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
*.sublime-workspace
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================================
# App-specific additions
# -----------------------------------------------------------------------------
# Add rules for a single app/package HERE, scoped by path, e.g.:
#
#   apps/admin/generated/
#   packages/ui/storybook-static/
#
# To track something a general rule above ignores, re-include it with "!"
# and a scoped path (the parent directory must not itself be ignored):
#
#   !packages/config/build/
#   !apps/website/.env.production
# =============================================================================
